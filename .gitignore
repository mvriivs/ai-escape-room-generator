# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
*.egg-info/

# nivel exportat pentru testare manuala la radacina proiectului (artefact, nu sursa)
/level.json

# ---------- Unity ----------
# (bazat pe template-ul oficial github/gitignore -- Unity.gitignore)
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!unity/[Ll]ibrary/ScriptAssemblies/*.meta

# Autogenerated VS/Rider/MD/Consulo solution and project files
unity/ExportedObj/
unity/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
unity/sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.log

# Visual Studio cache/options
.vs/
.vscode/

# nivelul generat de Python la Play/regenerare -- e artefact, nu sursa
unity/Assets/StreamingAssets/level.json
unity/Assets/StreamingAssets/level.json.meta
*.log
